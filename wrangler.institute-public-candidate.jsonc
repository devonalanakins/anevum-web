{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "anevum-institute-public-candidate",
  "main": "./apps/anevum-institute-preview/public-candidate-worker.mjs",
  "compatibility_date": "2026-11-18",
  "workers_dev": false,
  "preview_urls": false,
  "previews": {},
  "rules": [
    {
      "type": "Data",
      "globs": ["**/*.webp"],
      "fallthrough": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
